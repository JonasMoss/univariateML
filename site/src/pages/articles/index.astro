---
import Page from '../../layouts/Page.astro';
import {articles} from '../../lib/articles';
---
<Page title="Articles"><p class="eyebrow">Shared methods</p><h1>Articles</h1>{['Theory','Methods'].map(group=><section><h2>{group}</h2><ul>{articles.filter(a=>a.group===group).map(a=><li><a href={`/articles/${a.id}/`}>{a.title}</a></li>)}</ul></section>)}</Page>
