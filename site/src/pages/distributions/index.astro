---
import Page from '../../layouts/Page.astro';
import Catalog from '../../components/Catalog.svelte';
import families from '../../data/families.json';
// Keep implementation and examples out of the hydrated catalog payload.
const catalog=families.map(({id,name,summary,aliases,group,construction,areas,classification,fit,support_shape,support_dependence,coefficient_count,coefficient_kinds,support_tags,coefficient_tags,existence_tags,relations})=>({id,name,summary,aliases,group,construction,areas,classification,fit,support_shape,support_dependence,coefficient_count,coefficient_kinds,support_tags,coefficient_tags,existence_tags,relation_tags:Object.keys(relations).length?Object.entries(relations).filter(([,edges])=>edges.length).map(([kind])=>kind):['none']}));
---
<Page title="Distribution catalog"><p class="eyebrow">The catalog</p><h1>98 ways to describe a variable.</h1><p>Definitions, fitting behaviour and implementation notes, drawn directly from the library’s mathematical dossiers.</p><Catalog families={catalog} client:load/></Page>
