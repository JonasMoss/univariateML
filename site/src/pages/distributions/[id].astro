---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Definition from '../../components/Definition.astro';
import Explorer from '../../components/Explorer.svelte';
import binding from '../../data/binding.json';
import Usage from '../../components/Usage.astro';
import families from '../../data/families.json';
import { markdown } from '../../lib/markdown';
import { notices } from '../../lib/notices';
export async function getStaticPaths() {
 const entries=await getCollection('families');
 return entries.map(entry=>({params:{id:entry.id},props:{entry,f:families.find(f=>f.id===entry.id)}}));
}
const {entry,f}=Astro.props;
const explorerCatalog=(await getCollection('families')).filter(e=>binding.includes(e.id)).map(e=>({id:e.id,support:e.data.support}));
const source=`univariateML-cpp/include/cppunivariate/distributions/${f.id}/README.md`;
const body=entry.body || '';
const chunks=body.split(/^## /m);
const introRemainder=entry.data.summary ? chunks[0].trim() : chunks[0].trim().split(/\n\s*\n/).slice(1).join('\n\n');
const sections=chunks.slice(1).map(s=>{const i=s.indexOf('\n');return {title:s.slice(0,i).trim(),body:s.slice(i+1)};});
const prose=sections.filter(s=>!['details','decision history'].includes(s.title.toLowerCase()));
const implementation=sections.find(s=>s.title.toLowerCase()==='details');
const history=sections.find(s=>s.title.toLowerCase()==='decision history');
const render=(s:string)=>markdown(s,source);
const refs=f.key_references || f.references || [];
const unlinked=await Promise.all(f.unlinked_limits.map(async r=>({...r,noteHtml:await render(r.when)})));
const closurePoints=await Promise.all((f.relations.closure_point || []).map(async r=>({...r,pathHtml:await render(r.path)})));
const related=await Promise.all(f.related.map(async r=>({...r,noteHtml:r.note ? await render(r.note) : ''})));
const renderedProse=await Promise.all(prose.map(async s=>({...s,html:await render(s.body)})));
---
<Page title={f.name} description={f.summary}>
<article data-family={f.id}>
<p class="eyebrow">Distribution / {f.id}{f.classification ? ` / ${f.classification}` : ''}</p><h1>{f.name}</h1>
<div class="summary" set:html={await render(f.summary)}/>
{f.aliases?.length && <p>Also known as {f.aliases.join(', ')}.</p>}
{refs.length>0 && <div class="references"><h2>References</h2><ol>{refs.map((r:string)=><li>{r}</li>)}</ol></div>}
{notices(f).length>0 && <aside class="notices" aria-label="Fitting notices" set:html={await render(notices(f).join('\n\n'))}/>}
<section aria-label="Family taxonomy"><h2>Family taxonomy</h2>
<p>{f.group} · {f.classification}</p><p>{f.classification_reason}</p>
<dl><dt>Support</dt><dd>{f.support_tags.join(', ')}</dd>
<dt>Coefficients</dt><dd>{f.coefficient_tags.join(', ')}</dd>
<dt>Construction</dt><dd>{f.construction.join(', ')}</dd>
<dt>Existence</dt><dd>{f.existence_tags.join(', ')} · <a href="/articles/existence/#what-can-fail">Existence theory</a><ul>{(f.limits || []).map(l=><li>{l.model || l.name || l.status}: firmness {l.firmness || 'unassessed'}{l.numerical ? '; numerical detection' : ''}</li>)}</ul></dd>
<dt>Fit</dt><dd>{f.fit.method}; certification: {f.fit.certified}. {f.fit.note}</dd>
<dt>Areas</dt><dd>{f.areas.join('; ')}</dd></dl>
<p class="count">Editorial taxonomy. “Always” means no obstacle is declared; it is not an existence theorem. Fit certification does not describe inference validity.</p>
</section>
<section aria-label="Related families"><h2>Related families</h2>
{closurePoints.map(r=><p>Closure point: {r.name}. <span set:html={r.pathHtml}/> Never a likelihood supremum in the stated scope: {r.reason}</p>)}
<p><a href="/articles/limits/#declared-limits">Limits and escapes</a> · <a href="/articles/holds/#meaning-and-allowed-subsets">Held parameters</a> · <a href="/articles/restrictions/#scope-and-exemptions">Fit restrictions</a></p>
{f.related.length ? <ul>{related.map(r=><li>{r.kind}: <a data-relation href={`/distributions/${r.family}/`}>{r.name}</a>{r.edge && <span> ({r.edge.type ? `${r.edge.type}: ` : ''}{r.edge.mass ? `mass = ${r.edge.mass}; ` : ''}{r.edge.shift && r.edge.transform === 'abs' ? `shift = ${r.edge.shift}; ` : ''}{r.edge.transform ? `${r.edge.transform}: ` : ''}{Object.entries(r.edge.at).map(([key,value])=>`${key} = ${value}`).join(', ')})</span>}{r.note && <span set:html={r.noteHtml}/>}</li>)}</ul> : <p>No relation is declared yet.</p>}
{unlinked.length>0 && <details><summary>Other declared limits and failure boundaries ({unlinked.length})</summary><ul>{unlinked.map(r=><li>{r.name || r.status}{r.fixed?.length ? ` (held: ${r.fixed.join(', ')})` : ''}: <span set:html={r.noteHtml}/></li>)}</ul></details>}
</section>
<Definition f={f} source={source}/>
{binding.includes(f.id) && <Explorer client:visible family={{id:f.id,name:f.name,params:entry.data.params,support:entry.data.support}} catalog={explorerCatalog}/> }
{introRemainder && <div set:html={await render(introRemainder)}/>}
{renderedProse.map(s=><section><h2>{s.title}</h2><div set:html={s.html}/></section>)}
<Usage f={f}/>
{implementation && <details class="implementation"><summary id="details">Implementation</summary><div set:html={await render(implementation.body)}/></details>}
{history && <details><summary id="decision-history">Decision history</summary><div set:html={await render(history.body)}/></details>}
{f.key_references && f.references?.length>0 && <section class="references"><h2>Full references</h2><ol>{f.references.map((r:string)=><li>{r}</li>)}</ol></section>}
</article></Page>
