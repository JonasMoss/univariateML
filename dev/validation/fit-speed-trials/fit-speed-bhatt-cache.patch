+  // Cache only finite coordinates. Search status/iterations are attached
+  // to copies, so a cache hit preserves the exact objective and profile result.
+  mutable std::map<std::vector<double>,BhattResult> cache;
   BhattResult evaluate(const std::vector<double>& t) const {
+    for(double coordinate:t)if(!std::isfinite(coordinate))return evaluate_uncached(t);
+    const auto found=cache.find(t);
+    if(found!=cache.end())return found->second;
+    const auto value=evaluate_uncached(t);
+    if(cache.size()>=4096)cache.clear();
+    cache.emplace(t,value);
+    return value;
+  }
