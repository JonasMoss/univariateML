+// Warm inversion is confined to sorted fitter data. Each accepted root has
+// a checked log-quantile residual; difficult points use the public evaluator.
+inline double warm_density(double v,double mu,double sigma,double lambda,double& previous) {
+  if(lambda==0 || lambda== -1 || lambda>=1 || !valid(mu,sigma,lambda))
+    return distributions::dtlambda(v,mu,sigma,lambda,true);
+  const double target=logstandard(v,mu,sigma);
+  const double gap=lambda>0?slack(v,mu,sigma,lambda):1;
+  if(!std::isfinite(target) || !(gap>0))
+    return distributions::dtlambda(v,mu,sigma,lambda,true);
+  const bool deficit=lambda>0 && std::log(lambda)+target> -std::log(2.0);
+  const double goal=deficit?std::log(gap)-std::log(sigma):target;
+  double t=previous;
+  for(int k=0;k<6;++k) {
+    const double value=deficit?logdeficit(-t,lambda):logmag(-t,lambda);
+    const double residual=value-goal;
+    if(std::abs(residual)<2e-15) {
+      previous=t;
+      return -std::log(sigma)-logderiv(-t,lambda);
+    }
+    const double slope=std::exp((deficit?std::log(lambda):0)-t+logderiv(-t,lambda)-value);
+    const double next=deficit?t+residual/slope:t-residual/slope;
+    if(!(next>=std::log(2.0)) || !std::isfinite(next))break;
+    t=next;
+  }
+  const double lu=logsmall_log(target,lambda,lambda>0?std::log(gap)-std::log(sigma):std::numeric_limits<double>::quiet_NaN());
+  previous=-lu;
+  return -std::log(sigma)-logderiv(lu,lambda);
+}
+inline double sorted_likelihood(span x,double mu,double sigma,double lambda) {
+  std::vector<double> values(x.size());
+  const std::size_t middle=std::lower_bound(x.begin(),x.end(),mu)-x.begin();
+  double previous=std::log(2.0);
+  for(std::size_t j=middle;j<x.size();++j)values[j]=warm_density(x[j],mu,sigma,lambda,previous);
+  previous=std::log(2.0);
+  for(std::size_t j=middle;j>0;--j)values[j-1]=warm_density(x[j-1],mu,sigma,lambda,previous);
+  double ll=0;for(double value:values)ll+=value;
+  return ll;
+}
