+inline double likelihood(span x,double mu,double sigma,double lambda) {
+  if(!valid(mu,sigma,lambda))return special::kNaN;
+  const CPPUNIV_EXTENDED_REAL a=static_cast<CPPUNIV_EXTENDED_REAL>(lambda)*sigma;
+  const CPPUNIV_EXTENDED_REAL lograte=std::log(static_cast<CPPUNIV_EXTENDED_REAL>(lambda));
+  double ll=0;
+  for(double v:x) {
+    if(!std::isfinite(v))return special::kNegInf;
+    const CPPUNIV_EXTENDED_REAL z=(static_cast<CPPUNIV_EXTENDED_REAL>(v)-mu)/sigma;
+    ll+=static_cast<double>(lograte+logterm(z,a));
+  }
+  return ll;
+}
