@@ -302,19 +309,43 @@ with_parameters_mrg <- function(margins, parameters) {
   margins
 }
 
-scores_mrg_1 <- function(x, model) {
+with_margin_steps <- function(model, calculate) {
+  # Scale down the original step for small nonzero coefficients.
+  steps <- 1e-3 * pmin(1, ifelse(model == 0, 1, abs(model)))
+  for (i in seq_len(10)) {
+    result <- tryCatch(calculate(steps), error = identity)
+    if (!inherits(result, "error") && all(is.finite(result))) {
+      return(result)
+    }
+    steps <- steps / 2
+  }
+  detail <- if (inherits(result, "error")) conditionMessage(result) else "non-finite values"
+  stop(
+    "Cannot compute finite differences for margin ", attr(model, "model"),
+    ": ", detail, ".", call. = FALSE
+  )
+}
+
+margin_difference <- function(model, p, step, evaluate) {
+  lower <- upper <- model
+  lower[p] <- model[p] - step
+  upper[p] <- model[p] + step
+  if (lower[p] == model[p] || upper[p] == model[p]) {
+    stop("step too small to change the coefficient", call. = FALSE)
+  }
+  (evaluate(upper) - evaluate(lower)) / (upper[p] - lower[p])
+}
+
+scores_mrg_1 <- function(x, model, steps = NULL) {
+  if (is.null(steps)) {
+    return(with_margin_steps(model, function(h) scores_mrg_1(x, model, h)))
+  }
   npars <- length(model)
   scores <- matrix(NA, length(x), npars)
   for (p in seq_len(npars)) {
-    tmp_model <- model
-
-    tmp_model[p] <- model[p] - 1e-3
-    f_lwr <- univariateML::dml(x, tmp_model, log = TRUE)
-
-    tmp_model[p] <- model[p] + 1e-3
-    f_upr <- univariateML::dml(x, tmp_model, log = TRUE)
-
-    scores[, p] <- (f_upr - f_lwr) / 2e-3
+    scores[, p] <- margin_difference(model, p, steps[p], function(m) {
+      univariateML::dml(x, m, log = TRUE)
+    })
   }
   scores
 }
