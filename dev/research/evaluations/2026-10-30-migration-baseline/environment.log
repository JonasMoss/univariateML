# Personal R build config — NOT part of any package, invisible to CRAN.
#
# Route R's C/C++ compiler through ccache so repeated R-package C++ compiles are
# cache hits instead of full rebuilds. The big cost in this setup is Eigen-heavy
# template instantiation under -O2 (each misskappa .o is ~40M with -g); ccache
# returns the cached object instantly when the (preprocessed) source is
# unchanged, even across `R CMD INSTALL --preclean`. ccache lives at
# /usr/bin/ccache; the system compiler is plain g++ (no PATH masquerade).
#
# This changes nothing about the produced binary or its flags — same -O2 object,
# just cached. CRAN never sees this file.
CC    = ccache gcc
CXX   = ccache g++
CXX11 = ccache g++
CXX14 = ccache g++
CXX17 = ccache g++
CXX20 = ccache g++
CMAKE_CXX_COMPILER:FILEPATH=/usr/bin/c++
set(CMAKE_CXX_COMPILER_ID "GNU")
set(CMAKE_CXX_COMPILER_VERSION "15.2.0")
set(CMAKE_CXX_COMPILER_VERSION_INTERNAL "")
set(CMAKE_CXX_COMPILER_ID_RUN 1)
