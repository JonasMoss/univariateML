sged {"fixed": ["mean", "nu"], "name": "constant sample scale collapse", "status": "Unbounded", "when": "All observations equal the free or held mean and sd tends to zero"}
sged {"fixed": ["mean", "xi"], "model": "unif", "status": "UniformBoundary", "when": "nu tends to infinity with the held moment constraints"}
sged {"fixed": ["mean", "xi"], "name": "constant sample scale collapse", "status": "Unbounded", "when": "All observations equal the free or held mean and sd tends to zero"}
sged {"fixed": ["sd", "nu"], "name": "right translated half-family", "status": "RightHalfGedBoundary", "when": "xi tends to infinity with endpoint and scale constrained by held mean and sd"}
sged {"fixed": ["sd", "nu"], "name": "left translated half-family", "status": "LeftHalfGedBoundary", "when": "xi tends to zero with endpoint and scale constrained by held mean and sd"}
