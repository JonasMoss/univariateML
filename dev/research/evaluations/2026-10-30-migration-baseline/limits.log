pareto {"fixed": ["b"], "message": "constant data", "name": "unbounded likelihood", "status": "Unbounded", "when": "Every observation equals held b."}
pareto2 {"detect": "max over 0 < u < ubar of the profile log-likelihood gap is at most 1e-8*n", "name": "shifted exp; subtract min before fitting", "status": "ExponentialLimit", "when": "$\\kappa \\to \\infty$ with $\\lambda \\kappa$ fixed"}
pareto3 {"detect": "Constant samples; the held coefficients determine whether concentration remains free", "message": "unbounded", "name": "unbounded likelihood", "status": "Unbounded", "when": "A free concentration can collapse on constant observations"}
pareto4 {"detect": "Constant samples; the held coefficients determine whether concentration remains free", "message": "unbounded", "name": "unbounded likelihood", "status": "Unbounded", "when": "A free concentration can collapse on constant observations"}
pareto4 {"name": "shifted weibull; subtract min before fitting", "status": "WeibullBoundary", "when": "$\\mathrm{shape1} \\to \\infty$ with $\\mathrm{scale}\\,\\mathrm{shape1}^{-1/\\mathrm{shape2}}$ fixed"}
pareto4 {"name": "shifted pareto; subtract min before fitting", "status": "ParetoBoundary", "when": "$\\mathrm{shape2} \\to \\infty$ with $\\mathrm{shape1}\\,\\mathrm{shape2}$ and scale fixed"}
pareto4 {"detect": "all(x >= scale)", "fixed": ["scale"], "name": "shifted Pareto with its endpoint held at min + scale", "status": "AllGeOne", "when": "$\\mathrm{shape2} \\to \\infty$ with $\\mathrm{shape1}\\,\\mathrm{shape2}$ and scale fixed"}
pig {"detect": "Poisson maximised likelihood wins, including ties within 1e-8 times sample size", "model": "pois", "status": "PoissonLimit", "when": "$\\mathrm{shape} \\to \\infty$ at finite mean"}
