tbinom {"detect": "free size and probability; numerical profile approaches the truncated-Poisson face without exceeding it by 1e-9 times the sample size", "fixed": [], "model": "tpois", "status": "TpoisLimit", "when": "$size \\to \\infty$, $prob \\to 0$ with $size \\cdot prob$ finite"}
tbinom {"detect": "same numerical comparison, with the lower bound held", "fixed": ["a"], "model": "tpois", "status": "TpoisLimit", "when": "$size \\to \\infty$, $prob \\to 0$ with $size \\cdot prob$ finite"}
tbinom {"detect": "same numerical comparison, with the upper bound held", "fixed": ["b"], "model": "tpois", "status": "TpoisLimit", "when": "$size \\to \\infty$, $prob \\to 0$ with $size \\cdot prob$ finite"}
