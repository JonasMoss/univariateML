sged {"fixed": ["nu"], "name": "right translated half-family", "status": "RightHalfGedBoundary", "when": "xi tends to infinity with endpoint and scale constrained by held mean and sd"}
sged {"fixed": ["nu"], "name": "left translated half-family", "status": "LeftHalfGedBoundary", "when": "xi tends to zero with endpoint and scale constrained by held mean and sd"}
sged {"fixed": ["nu"], "name": "constant sample scale collapse", "status": "Unbounded", "when": "All observations equal the free or held mean and sd tends to zero"}
