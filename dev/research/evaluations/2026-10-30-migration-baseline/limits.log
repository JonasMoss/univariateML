tnorm {"detect": "mean((x - mean)^2) >= ((b - mean)^3 - (a - mean)^3) / (3 * (b - a))", "fixed": ["mean"], "name": "uniform", "status": "UniformBoundary", "when": "$\\mathrm{sd} \\to \\infty$, with $a$ and $b$ finite: the uniform law on $(a, b)$"}
