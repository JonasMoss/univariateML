+# ------------------------------------------------------------ derived widths (dev/research/evaluations/2026-11-15-root-widths-report.md)
+# A returned coefficient is within  bracket half width + conversion rounding + (error of the double-evaluated score) / (score slope)
+# [+ the represented-data term for weibull] of the exact root. The first two terms are exact; the third is an a priori bound.
+
+def ulp_of(v):
+    v = abs(float(v))
+    return 2.0**(math.floor(math.log2(v))-52) if v > 0 else 5e-324
+
+def location_half(z):
+    """half width of the bisection in z = log b (core/transformed_location.hpp:16-19): hi - lo <= 4 eps cannot be reached once
+    ulp(z) > 4 eps; the loop then ends at adjacent doubles (m == lo or m == hi) and returns an end point, 1 ulp(z) from the root."""
+    return max(ulp_of(z), 2*EPS+ulp_of(z)/2)
+
+LOCATION_SCORE_TERM = 9*EPS   # score evaluation (a priori <= 6.9 eps on the 66 baseline cases) + conversion exp, division (1.5 eps)
+GAMMA_SERIES_TERM = 20*EPS    # k >= 100: bracket 2 eps + score and s (a priori <= 17 eps on the 13 baseline cases, n <= 12)
+
+def log_minus_digamma_width(k, s):
+    """relative-shape error of the sign decision for G(k) = log k - psi(k) - s, double evaluation (gamma_detail::log_minus_digamma),
+    divided by the slope k |G'(k)|: E_G + E_s over k |G'|. E_G: series (k >= 100) 1.5 eps G; otherwise log (1 ulp assumed),
+    digamma (2 ulp, ASSUMED for boost::math::digamma) and the subtraction. E_s <= 70 eps s (a priori on the 22 baseline cases)."""
+    k = mp.mpf(k); psi = mp.digamma(k); G = mp.log(k)-psi
+    EG = 1.5*EPS*G if k >= 100 else EPS*abs(mp.log(k))+2*EPS*abs(psi)+EPS/2*abs(G)
+    slope = k*abs(1/k-mp.psi(1, k))
+    return float((EG+70*EPS*mp.mpf(s))/slope)
+
+def weibull_data_term(x, sigma0):
+    """first-order effect on log sigma of the binary64 rounding of y_i = -log(x_i/x_0) (weibull/mle.hpp:57-60): sum_j |d log sigma / d y_j| delta_j,
+    delta_j = 2^-52 (|log x_j| + |log x_0|) (two libm logs of 1 ulp and their difference) when the log-difference branch (|x_j/x_0 - 1| >= .5)
+    is taken, 2^-53 otherwise; sensitivities from the exact Gumbel scale equation F(sigma; d) = sigma - mean d + sum d e^(-d/sigma) / sum e^(-d/sigma)."""
+    with precision(40):
+        X = [mp.mpf(v) for v in x]; n = len(X); L = [mp.log(v) for v in X]
+        y0 = [-l for l in L]
+        def F(sig, y):
+            m = min(y); d = [v-m for v in y]; e = [mp.exp(-v/sig) for v in d]
+            return sig-sum(d)/n+sum(v*q for v, q in zip(d, e))/sum(e)
+        sig = mp.findroot(lambda t: F(t, y0), mp.mpf(sigma0), tol=mp.mpf(10)**-30, maxsteps=100)
+        Fs = mp.diff(lambda t: F(t, y0), sig)
+        total = mp.mpf(0)
+        for j in range(n):
+            def Fj(h, j=j):
+                y = list(y0); y[j] += h; return F(sig, y)
+            dFj = mp.diff(Fj, 0)
+            delta = 2.0**-52*(abs(L[j])+abs(L[0])) if abs(X[j]/X[0]-1) >= .5 else 2.0**-53
+            total += abs(dFj)/(sig*abs(Fs))*delta
+        return float(total)
+
 
