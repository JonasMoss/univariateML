=== Package Versions ===
extraDistr: 1.10.0.5 
actuar: 3.3.7 

=== EXTRADIST TESTS ===

--- Zero-inflated/truncated distributions ---
dzinb(10000, 2, 0.5, 0.1, log = TRUE)                         | ACTUAL:        -Inf  |  should be -6923.75 
pzinb(100, 2, 0.5, 0.1, lower.tail = FALSE, log.p = TRUE)     | ACTUAL:        -Inf  |  should be about -66.17 
qzinb(1, 2, 0.5, 1)                                           | ACTUAL: NA  |  should be 0 
dzib(9999, 10000, 0.4, 0.3, log = TRUE)                       | ACTUAL:        -Inf  |  should be finite (like dzinb) 
pzib(100, 10, 0.4, 0.3, lower.tail = FALSE, log.p = TRUE)     | ACTUAL:        -Inf  |  should be finite 
qzib(1, 10, 0.4, 1)                                           | ACTUAL: NA  |  should be 0 

--- Generalized Pareto ---
qgpd(0.5, xi = 1e-16)                                         | ACTUAL:           0  |  should be log(2) = 0.6931471806 
pgpd(1e-20)                                                   | ACTUAL:           0  |  should be about 1e-20 
pgpd(1000, xi = 0, lower.tail = FALSE, log.p = TRUE)          | ACTUAL:        -Inf  |  should be -1000 

--- Triangular ---
ptriang(0, 0, 1, 0)                                           | ACTUAL: NA  |  should be 0 

--- Huber ---
phuber(-60, 0, 1, 40)                                         | ACTUAL: NA  |  should be finite (not NaN from overflow) 

--- Generalized Extreme Value (GEV) ---
qgev(0.5, xi = 1e-16)                                         | ACTUAL:           0  |  should be 0.3665 
qgev(1, xi = -0.5)                                            | ACTUAL:         Inf  |  should be 2 
pgev(1000, lower.tail = FALSE, log.p = TRUE)                  | ACTUAL:        -Inf  |  should be -1000 

--- Truncated normal ---
dtnorm(10.05, a = 10, log = TRUE)                             | ACTUAL:         Inf  |  should be about 1.811 
qtnorm(0.5, a = 40, b = 41)                                   | ACTUAL:         Inf  |  should be finite (not Inf) 

--- Beta-Binomial ---
dbnbinom(0, 2, 4e14, 1e14, log = TRUE)                        | ACTUAL:    -0.46875  |  should be about -0.446 like dnbinom 
pbnbinom(0, 2, 4e14, 1e14)                                    | ACTUAL: 2.804569356  |  should be <= 1 (not 2.80) 

--- Beta-Binomial (second) ---
dbbinom(5, 10, 1e12, 1e12, log = TRUE)                        | ACTUAL: -1.401855469  |  should be about -1.40204 

--- Half-Cauchy, Half-t, Half-Normal ---
dhcauchy(1e200, log = TRUE)                                   | ACTUAL:        -Inf  |  should be about -921.486 
dht(1e200, 3, log = TRUE)                                     | ACTUAL: -1840.178591  |  should be finite (not -Inf from overflow) 
phcauchy(1e20, lower.tail = FALSE, log.p = TRUE)              | ACTUAL:        -Inf  |  should be about -46.503 
pht(1e20, 3, lower.tail = FALSE, log.p = TRUE)                | ACTUAL:        -Inf  |  should be negative (not -Inf) 
phnorm(1e20, lower.tail = FALSE, log.p = TRUE)                | ACTUAL:        -Inf  |  should be negative (not -Inf) 
qhcauchy(-100, lower.tail = FALSE, log.p = TRUE)              | ACTUAL: 1.633123935e+16  |  should be finite (not Inf) 
qht(-100, 3, lower.tail = FALSE, log.p = TRUE)                | ACTUAL:         Inf  |  should be about 3.90e14 
qhnorm(-100, lower.tail = FALSE, log.p = TRUE)                | ACTUAL:         Inf  |  should be finite (not Inf) 

--- Truncated Poisson and Binomial ---
dtpois(101, 2, 100, 110, log = TRUE)                          | ACTUAL:         Inf  |  should be about -0.0198 
qtbinom(0.5, 100, 0.1, 90, 100)                               | ACTUAL:         100  |  should be 91 (not 100) 

--- Discrete Laplace ---
pdlaplace(3, 5, 0.5)                                          | ACTUAL: -0.3333333333  |  should be 1/6 (not -1/3) 

--- Negative Hypergeometric ---
dnhyper(1003, 1000, 1000, 3, log = TRUE)                      | ACTUAL:        -Inf  |  should be about -1369.14 
dnhyper(0, 0, 0, 0) [segfault check - SKIPPED]               | ACTUAL: SKIPPED (known segfault)  | should not segfault

--- Reflected/Discrete Distributions ---
ddnorm(-40, log = TRUE)                                       | ACTUAL:        -Inf  |  should be finite (not -Inf) 
ddgamma(10, log = TRUE)                                       | ACTUAL: NA  |  should be finite (not -Inf) 

--- Skellam ---
dskellam(0, 1000, 1000, log = TRUE)                           | ACTUAL: NA  |  should be about -4.71933 (not NaN) 

--- Frechet ---
qfrechet(-40, 2, lower.tail = FALSE, log.p = TRUE)            | ACTUAL:         Inf  |  should be about 4.85e8 (not Inf) 
pfrechet(1e20, 2, lower.tail = FALSE, log.p = TRUE)           | ACTUAL:        -Inf  |  should be negative (not -Inf) 

--- Slash ---
pslash(1e-10) - 0.5                                           | ACTUAL: 3.989419906e-11  |  should be about 1.99e-11 

--- Bhattacharjee ---
dbhatt(10, log = TRUE)                                        | ACTUAL:        -Inf  |  should be about -44.3213 (not -Inf) 

--- Discrete Weibull ---
pdweibull(0.5, 0.7, 1)                                        | ACTUAL: 0.4143379814  |  should floor to pdweibull(0) = 0.300 
ddweibull(1000, 0.999, 2, log = TRUE)                         | ACTUAL:        -Inf  |  should be about -1000.645 


=== ACTUAR TESTS ===

--- Zero-truncated/modified distributions ---
dztnbinom(10000, 2, 0.4, log = TRUE)                          | ACTUAL:        -Inf  |  should be finite (not -Inf from underflow) 
pztpois(10000, 2, lower.tail = FALSE, log.p = TRUE)           | ACTUAL:        -Inf  |  should be negative (not -Inf) 
pzmlogarithmic(10000, 0.4, 0.3, lower.tail = FALSE, log.p = TRUE)  | ACTUAL: -36.40032833  |  should be below -9000 (not about -36.4) 
qztbinom(1, 10, 0.4)                                          | ACTUAL:         Inf  |  should be 10 (not Inf) 
qzmbinom(1, 10, 0.4)                                          | ACTUAL: NA  |  should be 10 (not Inf) 

--- Transformed Gamma ---
dtrgamma(1, 1e12, 1, scale = 1e-12, log = TRUE)               | ACTUAL:  12.8984375  |  should be 12.8966 (not 12.8984) 
ptrgamma(0.9, 1e-6, 1e6)                                      | ACTUAL:           0  |  should be 0.9 (not 0) 

--- Truncated Beta ---
ptrbeta(0.4, 0.003, 1000, 0.002)                              | ACTUAL:           0  |  should be about 0.0960 (not 0) 
ptrbeta(1e300, 2, 5, 3, lower.tail = FALSE, log.p = TRUE)     | ACTUAL:        -Inf  |  should be about -6905.96 (not -Inf) 
qtrbeta(0.5, 0.01, 1, 1)                                      | ACTUAL:         Inf  |  should be expm1(log(2)/0.01) = 1267650600228231653296516890624.0 (not Inf) 
qtrbeta(0.001, 0.06, 50, 0.04, lower.tail = FALSE)            | ACTUAL:         Inf  |  should be about 7.4 (not Inf) 

--- Poisson Inverse Gaussian ---
dpoisinvgauss(2, mean = 2, shape = 1e20, log = TRUE)          | ACTUAL: 0.6931471806  |  should be about -1.306852819 (not log(2)) 
dpoisinvgauss(1000, mean = 1000, shape = 1e12, log = TRUE)    | ACTUAL:        -Inf  |  should be about -4.372900006 (not -Inf) 

--- Generalized Beta ---
dgenbeta(0.5, 0.0001, 2, 100, log = TRUE)                     | ACTUAL: -3.918854482  |  should be precise at unit-gamma limit 
pgenbeta(1e-10, 0.0001, 2, 100, log.p = TRUE)                 | ACTUAL:        -Inf  |  should not underflow to -Inf 
qgenbeta(0.5, 0.0001, 2, 100)                                 | ACTUAL: 0.0008268997191  |  should be about 7.81e-31 (not 8.27e-4) 

--- Pareto Family ---
qfpareto(-40, 0, 0.3, 0.7, 0.4, lower.tail = FALSE, log.p = TRUE)  | ACTUAL:         Inf  |  should be about 6.89e81 (not Inf) 

=== END OF VERIFICATION ===
